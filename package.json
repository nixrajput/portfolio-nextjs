{
  "name": "portfolio-nextjs",
  "version": "2.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack -p 4000",
    "build": "next build --webpack",
    "vercel-build": "drizzle-kit migrate && next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:spell": "cspell --no-progress \"src/**/*.{ts,tsx,css}\" \"scripts/**/*.mjs\" \"*.md\"",
    "check:routes": "node scripts/check-routes.mjs",
    "check:vitals": "node scripts/check-vitals.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/db/seed.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "1.11.3",
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "@vercel/analytics": "2.0.1",
    "@vercel/blob": "2.9.0",
    "@vercel/speed-insights": "2.1.0",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "framer-motion": "14.14.0",
    "geist": "1.9.2",
    "lucide-react": "0.542.0",
    "next": "16.4.6",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.6",
    "postgres": "4.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-easy-crop": "6.2.5",
    "resend": "6.39.0",
    "sharp": "0.35.5",
    "tailwind-merge": "3.7.1",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.4",
    "@img/sharp-linux-x64": "0.35.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.7",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@tailwindcss/typography": "0.5.20",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "cspell": "10.5.2",
    "drizzle-kit": "0.31.11",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  },
  "overrides": {
    "postcss-selector-parser": "6.1.5",
    "zod": "4.6.7"
  }
}
