{
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Edit",
      "Write",
      "NotebookEdit",
      "WebSearch",
      "WebFetch",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git show)",
      "Bash(git show *)",
      "Bash(git rev-parse)",
      "Bash(git rev-parse *)",
      "Bash(git branch)",
      "Bash(git branch --list *)",
      "Bash(git branch -r)",
      "Bash(git branch -r *)",
      "Bash(git branch -a)",
      "Bash(git branch -v)",
      "Bash(git branch -vv)",
      "Bash(git remote)",
      "Bash(git remote -v)",
      "Bash(git remote show *)",
      "Bash(git stash list *)",
      "mcp__ide__*",
      "mcp__chrome-devtools__*",
      "mcp__claude-in-chrome__*",
      "mcp__playwright__*"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Read(/secrets/**)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.crt)",
      "Read(./**/*.cert)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Read(/**/*.key)",
      "Read(/**/*.pem)",
      "Read(/**/*.crt)",
      "Read(/**/*.cert)",
      "Read(/**/*.p12)",
      "Read(/**/*.pfx)",
      "Write(./.env)",
      "Write(./.env.*)",
      "Write(./**/.env)",
      "Write(./**/.env.*)",
      "Write(/**/.env)",
      "Write(/**/.env.*)",
      "Write(/secrets/**)",
      "Write(./secrets/**)",
      "Write(./config/credentials.json)",
      "Write(./**/*.key)",
      "Write(./**/*.pem)",
      "Write(./**/*.crt)",
      "Write(./**/*.cert)",
      "Write(./**/*.p12)",
      "Write(./**/*.pfx)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(./**/.env)",
      "Edit(./**/.env.*)",
      "Edit(/**/.env)",
      "Edit(/**/.env.*)",
      "Edit(/secrets/**)",
      "Edit(./secrets/**)",
      "Edit(./config/credentials.json)",
      "Edit(./**/*.key)",
      "Edit(./**/*.pem)",
      "Edit(./**/*.crt)",
      "Edit(./**/*.cert)",
      "Edit(./**/*.p12)",
      "Edit(./**/*.pfx)"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(shred *)",
      "Bash(unlink *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(fdisk *)",
      "Bash(chmod *)",
      "Bash(chown *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git push --force *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git restore *)",
      "Bash(git clean *)",
      "Bash(git stash *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git remote add *)",
      "Bash(git remote remove *)",
      "Bash(git remote set-url *)",
      "Bash(docker *)",
      "Bash(kubectl *)",
      "Bash(firebase *)",
      "Bash(gcloud *)",
      "Bash(kill *)",
      "Bash(killall *)",
      "Bash(pkill *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "outputStyle": "Explanatory",
  "alwaysThinkingEnabled": true
}
